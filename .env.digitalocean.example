# CloudGuard on DigitalOcean
# Copy to .env on the DigitalOcean Droplet, or map these values into App Platform.

# Public app
DOMAIN=cloudguard.example.com
CADDY_EMAIL=security@example.com
ALLOWED_HOSTS=cloudguard.example.com
CORS_ORIGINS=https://cloudguard.example.com

# Required in production. Tokens must contain organization_id and this audience.
CLOUDGUARD_AUTH_REQUIRED=true
KEYCLOAK_PUBLIC_URL=https://auth.example.com
KEYCLOAK_ISSUER=https://auth.example.com/realms/gigachad-grc
KEYCLOAK_JWKS_URL=https://auth.example.com/realms/gigachad-grc/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=cloudguard-api
CLOUDGUARD_KEYCLOAK_CLIENT_ID=cloudguard-frontend

# Database
# Use this local compose default, or replace with a DigitalOcean Managed PostgreSQL URL.
POSTGRES_DB=scanner_db
POSTGRES_USER=scanner_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://scanner_user:change-me@postgres:5432/scanner_db

# Queue and workers
QUEUE_BACKEND=postgres
SCAN_JOB_INLINE_WORKER=false
WORKER_AUTH_REQUIRED=true
WORKER_TOKEN=change-me-worker-token
SCAN_JOB_TIMEOUT_MINUTES=20
SCAN_WORKER_ID=do-scan-worker-1
SCAN_WORKER_POLL_INTERVAL=10
SCHEDULER_WORKER_ID=do-scheduler-worker-1
WORKER_HEARTBEAT_INTERVAL=15
WORKER_HEARTBEAT_STALE_SECONDS=45

# Evidence storage: DigitalOcean Spaces is S3-compatible
OBJECT_STORAGE_PROVIDER=digitalocean-spaces
OBJECT_STORAGE_ENDPOINT_URL=https://blr1.digitaloceanspaces.com
OBJECT_STORAGE_REGION=blr1
OBJECT_STORAGE_BUCKET=cloudguard-evidence
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-spaces-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-spaces-secret
OBJECT_STORAGE_PREFIX=cloudguard/evidence

# AI: self-hosted OpenAI-compatible endpoint on Proxmox/E2E/DO
AI_BASE_URL=http://your-model-host:11434/v1
AI_MODEL=llama3.1
AI_API_KEY=local-model

# Optional OpenAI fallback
# OPENAI_API_KEY=
# OPENAI_AGENT_MODEL=gpt-4o-mini

# App secrets
SECRET_KEY=change-me
ENCRYPTION_KEY=change-me
# Keep this key identical across the API and all workers; preserve it on upgrades.
LOG_LEVEL=INFO

# Cloud scan credentials should be added through the UI.
# Keep AWS/GCP/Azure credentials out of platform env unless you intentionally want env fallback scanning.

# Automatic organization provisioning through the GRC controls service.
GRC_ONBOARDING_URL=https://grc.example.com/api/auth/onboard
