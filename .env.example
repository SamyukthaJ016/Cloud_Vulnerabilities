# ============================================================================
# Cloud Security Scanner - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================================================
# Application Settings
# ============================================================================
APP_ENV=development  # development, staging, production
LOG_LEVEL=INFO       # DEBUG, INFO, WARNING, ERROR, CRITICAL
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ============================================================================
# Database Configuration
# ============================================================================
POSTGRES_DB=scanner_db
POSTGRES_USER=scanner_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://scanner_user:change_me_in_production@postgres:5432/scanner_db

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_PASSWORD=redis_password
REDIS_PORT=6379
REDIS_URL=redis://:redis_password@redis:6379/0

# ============================================================================
# AWS Credentials
# ============================================================================
# Get these from AWS IAM
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# ============================================================================
# GCP Credentials
# ============================================================================
# Path to your GCP service account JSON file
GCP_PROJECT_ID=your-gcp-project-id
GCP_SERVICE_ACCOUNT_JSON=/app/config/gcp-service-account.json

# Or use the JSON content directly (base64 encoded for security)
# GCP_SERVICE_ACCOUNT_JSON_BASE64=<base64-encoded-json>

# ============================================================================
# OpenAI API Configuration
# ============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-organization-id  # Optional
OPENAI_AGENT_MODEL=gpt-4o-mini          # gpt-4o-mini, gpt-4, gpt-3.5-turbo

# ============================================================================
# Security Settings
# ============================================================================
ALLOWED_HOSTS=*  # Comma-separated list or * for all
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:80

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_DEEP_SCAN=true
ENABLE_VULNERABILITY_SCAN=true
ENABLE_AI_ANALYSIS=true
ENABLE_SCHEDULED_SCANS=false

# ============================================================================
# Scanning Configuration
# ============================================================================
SCAN_SCHEDULE=0 2 * * *  # Cron format: Daily at 2 AM
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT=3600        # Seconds

# ============================================================================
# Server Ports
# ============================================================================
BACKEND_PORT=8000
FRONTEND_PORT=80
FRONTEND_SSL_PORT=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
JAEGER_UI_PORT=16686

# ============================================================================
# Monitoring Configuration
# ============================================================================
GRAFANA_PASSWORD=admin
PROMETHEUS_RETENTION_TIME=30d

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_SCAN_PER_HOUR=10

# ============================================================================
# Email Notifications (Optional)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=security-alerts@yourdomain.com

# ============================================================================
# Slack Notifications (Optional)
# ============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#security-alerts

# ============================================================================
# External Integrations (Optional)
# ============================================================================
# Jira for ticket creation
JIRA_URL=https://yourdomain.atlassian.net
JIRA_USERNAME=your-email@domain.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=SEC

# PagerDuty for critical alerts
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-integration-key

# ============================================================================
# Backup Configuration
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *  # Daily at 3 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket  # Optional: S3 backup

# ============================================================================
# Performance Tuning
# ============================================================================
WORKER_PROCESSES=4
MAX_CONNECTIONS=100
CACHE_TTL=3600           # Seconds
POOL_SIZE=20             # Database connection pool

# ============================================================================
# Development Settings (only for development)
# ============================================================================
DEBUG=false              # Set to true only in development
RELOAD=false             # Auto-reload on code changes
PROFILING_ENABLED=false  # Enable performance profiling

# ============================================================================
# Testing Settings (only for testing)
# ============================================================================
TEST_DATABASE_URL=postgresql://scanner_user:change_me_in_production@postgres:5432/scanner_db_test

# ============================================================================
# Security Tool Configuration
# ============================================================================
TRIVY_SEVERITY=CRITICAL,HIGH,MEDIUM
TRIVY_TIMEOUT=300
GITLEAKS_VERBOSE=false
NUCLEI_TEMPLATES=https://github.com/projectdiscovery/nuclei-templates

# ============================================================================
# Compliance Frameworks
# ============================================================================
COMPLIANCE_FRAMEWORKS=CIS,NIST,OWASP,PCI-DSS,HIPAA,SOC2
DEFAULT_COMPLIANCE_FRAMEWORK=CIS

# ============================================================================
# Notes
# ============================================================================
# 1. Generate a strong SECRET_KEY:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. For GCP service account, place your JSON file in config/ directory
#    and update the path above
#
# 3. For production, use a secrets manager (AWS Secrets Manager, 
#    HashiCorp Vault, etc.) instead of .env files
#
# 4. Make sure to set appropriate file permissions:
#    chmod 600 .env
#
# 5. Never commit .env to version control!
#    Add .env to .gitignore