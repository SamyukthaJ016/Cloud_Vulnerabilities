{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "query",
          "key": "token"
        }
      ],
      "dest": "/index.py"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/dashboard/?$",
      "has": [
        {
          "type": "query",
          "key": "token"
        }
      ],
      "dest": "/index.py"
    },
    {
      "src": "^/dashboard/?$",
      "has": [
        {
          "type": "query",
          "key": "scanId"
        }
      ],
      "dest": "/index.py"
    },
    {
      "src": "^/dashboard/?$",
      "has": [
        {
          "type": "query",
          "key": "scan_id"
        }
      ],
      "dest": "/index.py"
    },
    {
      "src": "^/dashboard/?$",
      "has": [
        {
          "type": "query",
          "key": "scanIds"
        }
      ],
      "dest": "/index.py"
    },
    {
      "src": "^/dashboard/?$",
      "has": [
        {
          "type": "query",
          "key": "scan_ids"
        }
      ],
      "dest": "/index.py"
    },
    {
      "src": "^/dashboard/?$",
      "dest": "/dashboard.html"
    },
    {
      "src": "^/frontend/history\\.html$",
      "has": [
        {
          "type": "query",
          "key": "token"
        }
      ],
      "dest": "/index.py"
    },
    {
      "src": "^/frontend/history\\.html$",
      "dest": "/frontend/history.html"
    },
    {
      "src": "^/schedules/?$",
      "has": [
        {
          "type": "query",
          "key": "token"
        }
      ],
      "dest": "/index.py"
    },
    {
      "src": "^/schedules/?$",
      "dest": "/scheduled_scans.html"
    },
    {
      "src": "^/system-status/?$",
      "has": [
        {
          "type": "query",
          "key": "token"
        }
      ],
      "dest": "/index.py"
    },
    {
      "src": "^/system-status/?$",
      "dest": "/system_status.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.py"
    }
  ]
}
