{
  "name": "cloudguard-control-plane",
  "version": "0.1.0",
  "description": "CloudGuard Control Plane monorepo - backend (NestJS) + frontend (Vite React) + shared types",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:backend": "pnpm --filter backend start:dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:all": "pnpm -r --parallel --filter=!shared dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prisma:migrate": "pnpm --filter backend prisma:migrate",
    "prisma:seed": "pnpm --filter backend prisma:seed",
    "prisma:studio": "pnpm --filter backend prisma:studio",
    "format": "pnpm -r format"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
