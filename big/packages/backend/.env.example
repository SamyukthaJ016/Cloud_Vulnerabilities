# App
NODE_ENV=development
APP_PORT=3100
APP_BASE_URL=http://localhost:3100
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:55433/cloudguard?schema=public

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (app session)
JWT_SECRET=local-dev-jwt-secret-please-replace-this-32chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=local-dev-refresh-secret-please-replace-this
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0
GOOGLE_CLIENT_ID=local-dev-google-client-id
GOOGLE_CLIENT_SECRET=local-dev-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3100/api/auth/google/callback

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# HashiCorp Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-only-root-token
VAULT_KV_MOUNT=secret
VAULT_ORG_PATH_PREFIX=orgs

# Scanner services
SCANNER_CALLBACK_BASE_URL=http://localhost:3100
SCANNER_1_BASE_URL=http://localhost:4001
SCANNER_1_SHARED_SECRET=

# Main CloudGuard app mirror
CLOUDGUARD_BASE_URL=https://cloud-vulnerabilities.vercel.app
CLOUDGUARD_USER_ID=anonymous

# Object storage for scan artifacts (optional for v1)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=cloudguard-artifacts
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Observability
LOG_LEVEL=debug
