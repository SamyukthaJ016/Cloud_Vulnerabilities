// ─────────────────────────────────────────────────────────────
// CloudGuard Control Plane - Prisma schema
// Covers every node in Flow-Diagram.mmd
// Grouped by domain to match the module folders in src/modules/
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════════════════════════════════════════
// IDENTITY & TENANCY  (modules: auth, users, organizations)
// Flow nodes: I, J, K, L, M, N
// ═════════════════════════════════════════════════════════════

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  emailVerified Boolean    @default(false)
  name          String?
  avatarUrl     String?

  // SSO identity — Google is the only provider for v1
  ssoProvider   SsoProvider
  ssoSubject    String      // Google `sub` claim

  status        UserStatus  @default(PENDING)
  lastLoginAt   DateTime?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  memberships      OrgMember[]
  secretsCreated   Secret[]    @relation("SecretCreatedBy")
  scanJobs         ScanJob[]   @relation("ScanTriggeredBy")
  auditLogs        AuditLog[]

  @@unique([ssoProvider, ssoSubject])
}

enum SsoProvider {
  GOOGLE
}

enum UserStatus {
  PENDING      // created, no org assigned yet (flow K, N1)
  ACTIVE
  SUSPENDED
  UNASSIGNED   // SSO ok but no org mapping (flow N1)
}

model Organization {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  slug      String     @unique
  // Email domain (e.g. "acme.com") for self-serve auto-join. Unique so two orgs
  // can't both claim the same corporate domain. Null disables auto-join.
  domain    String?    @unique
  status    OrgStatus  @default(ACTIVE)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  members              OrgMember[]
  subscription         Subscription?
  paymentOrders        PaymentOrder[]
  secrets              Secret[]
  scanJobs             ScanJob[]
  findings             Finding[]
  auditLogs            AuditLog[]
  webhookSubscriptions WebhookSubscription[]
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model OrgMember {
  id       String            @id @default(uuid()) @db.Uuid
  orgId    String            @db.Uuid
  userId   String            @db.Uuid
  roleId   String            @db.Uuid
  status   MembershipStatus  @default(ACTIVE)
  joinedAt DateTime          @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role         @relation(fields: [roleId], references: [id])

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

// ═════════════════════════════════════════════════════════════
// RBAC  (module: rbac)
// Flow nodes: O (role/entitlements resolution), AB (secret authz), CF (scan authz)
// ═════════════════════════════════════════════════════════════

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // 'org_admin' | 'org_member' | 'viewer' | 'scanner_operator'
  name        String
  description String?
  isSystem    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  members     OrgMember[]
}

model Permission {
  id       String @id @default(uuid()) @db.Uuid
  key      String @unique // e.g. 'secret.write', 'scan.run', 'billing.manage'
  resource String // 'secret' | 'scan' | 'billing' | 'org' | 'user' | 'audit'
  action   String // 'read' | 'write' | 'delete' | 'run' | 'manage'

  roles RolePermission[]
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ═════════════════════════════════════════════════════════════
// BILLING  (modules: plans, subscriptions, billing, billing-webhooks)
// Flow nodes: X2, BA, BB, BC, BF→BL, CG, CH
// ═════════════════════════════════════════════════════════════

model Plan {
  id              String          @id @default(uuid()) @db.Uuid
  key             String          @unique // 'free' | 'pro' | 'enterprise'
  name            String
  description     String?
  priceInPaise    Int             // INR paise (1 INR = 100 paise)
  currency        String          @default("INR")
  billingInterval BillingInterval
  isActive        Boolean         @default(true)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  entitlements  PlanEntitlement[]
  subscriptions Subscription[]
}

enum BillingInterval {
  MONTHLY
}

// Per-plan entitlements used by scan authorization (flow CG, CH).
// Examples:
//   key='max_scans_per_month', valueInt=100
//   key='max_concurrent_scans', valueInt=5
//   key='scanner.scanner_1.enabled', valueBool=true
model PlanEntitlement {
  id          String   @id @default(uuid()) @db.Uuid
  planId      String   @db.Uuid
  key         String
  valueInt    Int?
  valueBool   Boolean?
  valueString String?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model Subscription {
  id                    String             @id @default(uuid()) @db.Uuid
  orgId                 String             @unique @db.Uuid
  planId                String             @db.Uuid
  status                SubscriptionStatus @default(ACTIVE)
  startedAt             DateTime           @default(now())
  currentPeriodEnd      DateTime?
  canceledAt            DateTime?
  razorpaySubscriptionId String?           @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan Plan         @relation(fields: [planId], references: [id])

  @@index([orgId])
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model PaymentOrder {
  id                 String        @id @default(uuid()) @db.Uuid
  orgId              String        @db.Uuid
  planId             String        @db.Uuid
  razorpayOrderId    String        @unique
  razorpayPaymentId  String?
  amountInPaise      Int
  currency           String        @default("INR")
  status             PaymentStatus @default(CREATED)
  metadata           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([status])
}

enum PaymentStatus {
  CREATED
  ATTEMPTED
  PAID
  FAILED
  REFUNDED
}

// Inbound webhook events from payment providers.
// eventId is the dedupe key (flow BH: "not replayed").
model WebhookEvent {
  id          String              @id @default(uuid()) @db.Uuid
  provider    String              // 'razorpay'
  eventId     String              @unique
  eventType   String
  payload     Json
  signature   String
  receivedAt  DateTime            @default(now())
  processedAt DateTime?
  status      WebhookEventStatus  @default(PENDING)
  error       String?

  @@index([provider, eventType])
  @@index([status])
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
  REJECTED // signature invalid or replay detected
}

// ═════════════════════════════════════════════════════════════
// SECRETS  (module: secrets)
// Flow nodes: X3, Y→AG
// App DB stores METADATA ONLY. Actual secret lives in Vault.
// ═════════════════════════════════════════════════════════════

model Secret {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @db.Uuid
  scannerKey   String?      // scanner this secret belongs to (null = org-level)
  key          String       // logical name, e.g. 'aws_access_key'
  vaultPath    String       // e.g. 'secret/data/orgs/{orgId}/{scannerKey}/{key}'
  vaultVersion Int?
  status       SecretStatus @default(ACTIVE)
  createdById  String       @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  rotatedAt DateTime?

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User         @relation("SecretCreatedBy", fields: [createdById], references: [id])

  @@unique([orgId, scannerKey, key])
  @@index([orgId])
}

enum SecretStatus {
  ACTIVE
  ROTATING
  REVOKED
}

// ═════════════════════════════════════════════════════════════
// SCANNERS  (module: scanners)
// Flow nodes: V, X4, SA1-SAN
// Catalog populated at boot from each scanner's GET /api/manifest.
// ═════════════════════════════════════════════════════════════

model Scanner {
  id                String              @id @default(uuid()) @db.Uuid
  key               String              @unique // stable identifier from manifest
  name              String
  description       String?
  version           String              @default("1.0.0")
  category          String?             // 'cloud' | 'code' | 'network' | 'container'
  baseUrlEnvKey     String              // which env var holds this scanner's base URL (e.g. SCANNER_1_BASE_URL)
  credentialSchema  Json                // JSON Schema for fields the modal collects
  dashboardBaseUrl  String?             // for "View report" redirect
  iconUrl           String?
  availability      ScannerAvailability @default(AVAILABLE)
  lastError         String?
  manifestFetchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scanJobs ScanJob[]
}

enum ScannerAvailability {
  AVAILABLE
  UNAVAILABLE
}

// ═════════════════════════════════════════════════════════════
// SCANS  (modules: scans, scanner-callbacks, scanner-clients)
// Flow nodes: CA→CP, GT, O1
// Credentials are NEVER persisted — forwarded once to the scanner then forgotten.
// ═════════════════════════════════════════════════════════════

model ScanJob {
  id             String     @id @default(uuid()) @db.Uuid
  orgId          String     @db.Uuid
  scannerId      String     @db.Uuid
  triggeredById  String     @db.Uuid
  status         ScanStatus @default(DISPATCHED)

  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  // external scanner correlation (outbound dispatch / inbound callback)
  externalScanId String?
  callbackNonce  String?  // random nonce we send; scanner echoes it back in signed callback
  error          String?

  // populated from completion callback
  viewSecretHash String?  // bcrypt hash of scanner-issued view token
  summary        Json?    // { critical, high, medium, low, info }

  metadata Json?

  org         Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scanner     Scanner        @relation(fields: [scannerId], references: [id])
  triggeredBy User           @relation("ScanTriggeredBy", fields: [triggeredById], references: [id])
  findings    Finding[]
  artifacts   ScanArtifact[]

  @@index([orgId, status])
  @@index([scannerId])
  @@index([externalScanId])
}

enum ScanStatus {
  DISPATCHED // sent to external scanner, awaiting callback
  RUNNING
  COMPLETED
  FAILED
}

// ═════════════════════════════════════════════════════════════
// FINDINGS  (module: findings)
// Flow nodes: GU, K1, L1, M1, N1A, R1-V1
// Normalized schema across all scanners.
// ═════════════════════════════════════════════════════════════

model Finding {
  id             String        @id @default(uuid()) @db.Uuid
  orgId          String        @db.Uuid
  scanJobId      String        @db.Uuid
  scannerKey     String        // redundant for fast filtering without joining Scanner
  externalId     String?       // id from the source scanner
  title          String
  description    String?
  severity       Severity
  resource       String?       // asset/target the finding applies to
  evidence       Json?
  recommendation String?
  status         FindingStatus @default(OPEN)
  tags           String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scanJob ScanJob      @relation(fields: [scanJobId], references: [id], onDelete: Cascade)

  @@index([orgId, severity])
  @@index([orgId, status])
  @@index([scanJobId])
  @@index([scannerKey])
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  TRIAGED
  ACCEPTED
  RESOLVED
  FALSE_POSITIVE
}

model ScanArtifact {
  id         String   @id @default(uuid()) @db.Uuid
  scanJobId  String   @db.Uuid
  kind       String   // 'raw_output' | 'log' | 'report'
  storageUrl String   // S3 / object store URL
  checksum   String?
  sizeBytes  Int?
  createdAt  DateTime @default(now())

  scanJob ScanJob @relation(fields: [scanJobId], references: [id], onDelete: Cascade)

  @@index([scanJobId])
}

// ═════════════════════════════════════════════════════════════
// AUDIT  (module: audit)
// Flow nodes: TS6, AF, BK, P1, CF1, AB1, BH1
// One row per significant action by any actor.
// ═════════════════════════════════════════════════════════════

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   // e.g. 'secret.create', 'scan.run', 'billing.update', 'user.login'
  resource    String
  resourceId  String?
  ipAddress   String?
  userAgent   String?
  details     Json?
  createdAt   DateTime @default(now())

  org   Organization? @relation(fields: [orgId], references: [id])
  actor User?         @relation(fields: [actorUserId], references: [id])

  @@index([orgId, createdAt])
  @@index([actorUserId])
  @@index([action])
}

// ═════════════════════════════════════════════════════════════
// OUTBOUND WEBHOOKS  (module: webhooks-outbound)
// Flow node: Q1 (external webhooks — customer-configured)
// ═════════════════════════════════════════════════════════════

model WebhookSubscription {
  id       String   @id @default(uuid()) @db.Uuid
  orgId    String   @db.Uuid
  url      String
  secret   String   // HMAC signing secret given to customer
  events   String[] // 'scan.completed' | 'finding.created' | ...
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([orgId])
}

model WebhookDelivery {
  id             String         @id @default(uuid()) @db.Uuid
  subscriptionId String         @db.Uuid
  eventType      String
  payload        Json
  responseStatus Int?
  responseBody   String?
  attemptCount   Int            @default(0)
  status         DeliveryStatus @default(PENDING)
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?

  createdAt DateTime @default(now())

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status, nextAttemptAt])
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  ABANDONED
}
