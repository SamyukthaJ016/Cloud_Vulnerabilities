{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "description": "CloudGuard dashboard (Vite + React + Tailwind + shadcn/ui)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
