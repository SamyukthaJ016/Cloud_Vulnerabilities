# Frontend env — all vars must be prefixed with VITE_ to be exposed to the browser.

# Backend
VITE_API_BASE_URL=http://localhost:3100/api
VITE_WS_BASE_URL=http://localhost:3100/ws

# Google OAuth consent — the frontend never sees client secret; it just links to backend.
# No client id needed here; backend handles the OAuth redirect.

# Razorpay Checkout (publishable key id — safe to expose)
VITE_RAZORPAY_KEY_ID=

# Main CloudGuard scanner app
VITE_MAIN_PROJECT_URL=https://cloud-vulnerabilities.vercel.app
