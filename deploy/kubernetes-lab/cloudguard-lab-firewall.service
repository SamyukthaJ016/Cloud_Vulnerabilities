[Unit]
Description=CloudGuard Kubernetes lab network restrictions
Wants=network-online.target
After=network-online.target ufw.service
Before=k3s.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/cloudguard-lab-firewall.env
ExecStart=/bin/bash /opt/cloudguard-kubernetes-lab/configure-lab-firewall.sh

[Install]
WantedBy=multi-user.target
