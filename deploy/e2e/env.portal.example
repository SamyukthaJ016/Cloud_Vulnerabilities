DOMAIN=cloudscanner.example.com
CADDY_EMAIL=ops@example.com
ALLOWED_HOSTS=cloudscanner.example.com
CORS_ORIGINS=https://cloudscanner.example.com

POSTGRES_DB=scanner_db
