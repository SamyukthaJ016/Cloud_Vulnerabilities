DOMAIN=cloudscanner.example.com
ALLOWED_HOSTS=cloudscanner.example.com
CORS_ORIGINS=https://cloudscanner.example.com
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000

POSTGRES_DB=scanner_db
POSTGRES_USER=scanner_user
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgresql://scanner_user:change-me-postgres@postgres:5432/scanner_db
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

WORKER_AUTH_REQUIRED=true
WORKER_TOKEN=change-me-worker-token
SCHEDULER_WORKER_ID=e2e-scheduler-worker-1
WORKER_HEARTBEAT_INTERVAL=15
WORKER_HEARTBEAT_STALE_SECONDS=45
KEYCLOAK_PUBLIC_URL=https://auth.example.com
KEYCLOAK_ISSUER=https://auth.example.com/realms/gigachad-grc
KEYCLOAK_JWKS_URL=https://auth.example.com/realms/gigachad-grc/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=cloudguard-api
CONNECTOR_CREDENTIALS_JSON={"e2e-evidence-connector-1":{"token":"change-me-evidence-connector-token-at-least-32-characters","tenant_id":"demo-tenant","user_id":"keycloak-user-id","scopes":["evidence:write","worker:heartbeat"]}}

MINIO_ROOT_USER=cloudguard-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_REGION=e2e
OBJECT_STORAGE_BUCKET=cloudguard-evidence
OBJECT_STORAGE_ACCESS_KEY_ID=cloudguard-minio
OBJECT_STORAGE_SECRET_ACCESS_KEY=change-me-minio-secret
OBJECT_STORAGE_PREFIX=cloudguard/evidence

AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=

SECRET_KEY=change-me-secret-key
ENCRYPTION_KEY=change-me-encryption-key

SANDBOX_LABS_ENABLED=true
SANDBOX_LAB_INLINE_WORKER=false
SANDBOX_LAB_BASE_DIR=/app/sandbox-labs
SANDBOX_IAC_DEPLOY=true
SANDBOX_AWS_DEPLOY=false
SANDBOX_GCP_DEPLOY=false
SANDBOX_KUBERNETES_DEPLOY=false

LOG_LEVEL=INFO
