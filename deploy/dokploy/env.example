# CloudGuard Dokploy PoC environment
# Replace every "change-me" before deploying.

# Public domains. In Dokploy, add these as Domains for the backend service
# and route them to internal port 8000.
APP_DOMAIN=app.cloudscanner.example.com
API_DOMAIN=api.cloudscanner.example.com
INGEST_DOMAIN=ingest.cloudscanner.example.com
ALLOWED_HOSTS=app.cloudscanner.example.com,api.cloudscanner.example.com,ingest.cloudscanner.example.com
CORS_ORIGINS=https://app.cloudscanner.example.com,https://api.cloudscanner.example.com,https://ingest.cloudscanner.example.com

# Postgres
POSTGRES_DB=scanner_db
POSTGRES_USER=scanner_user
POSTGRES_PASSWORD=change-me-postgres-password

# Worker and connector auth. Create a different high-entropy token for every
# connector and keep the JSON only in Dokploy's encrypted environment store.
WORKER_TOKEN=change-me-worker-token
EVIDENCE_CONNECTOR_TOKEN=change-me-evidence-connector-token-at-least-32-characters
CONNECTOR_CREDENTIALS_JSON={"dokploy-evidence-connector-1":{"token":"change-me-evidence-connector-token-at-least-32-characters","tenant_id":"demo-tenant","user_id":"keycloak-user-id","scopes":["evidence:write","worker:heartbeat"]},"grc-demo-tenant":{"token":"change-me-grc-connector-token-at-least-32-characters","tenant_id":"demo-tenant","user_id":"keycloak-user-id","scopes":["grc:read"]}}

# Keycloak JWT verification. Keycloak must put organization_id and the
# configured audience into every access token.
KEYCLOAK_PUBLIC_URL=https://auth.cloudscanner.example.com
KEYCLOAK_ISSUER=https://auth.cloudscanner.example.com/realms/gigachad-grc
KEYCLOAK_JWKS_URL=https://auth.cloudscanner.example.com/realms/gigachad-grc/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=cloudguard-api
KEYCLOAK_REALM=gigachad-grc
CLOUDGUARD_KEYCLOAK_CLIENT_ID=cloudguard-frontend

# Internal MinIO evidence storage for the PoC.
# For production, replace this with managed S3-compatible object storage if available.
MINIO_ROOT_USER=cloudguard-minio
MINIO_ROOT_PASSWORD=change-me-minio-root-password
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_REGION=dokploy
OBJECT_STORAGE_BUCKET=cloudguard-evidence
OBJECT_STORAGE_ACCESS_KEY_ID=cloudguard-minio
OBJECT_STORAGE_SECRET_ACCESS_KEY=change-me-minio-root-password
OBJECT_STORAGE_PREFIX=cloudguard/evidence

# App secrets
SECRET_KEY=change-me-secret-key
ENCRYPTION_KEY=change-me-encryption-key

# Scanner runtime
SCAN_WORKER_ID=dokploy-scan-worker-1
SCHEDULER_WORKER_ID=dokploy-scheduler-worker-1
SCAN_WORKER_POLL_INTERVAL=10
SCAN_JOB_TIMEOUT_MINUTES=20
WORKER_HEARTBEAT_INTERVAL=15
WORKER_HEARTBEAT_STALE_SECONDS=45
EVIDENCE_CONNECTOR_ID=dokploy-evidence-connector-1
EVIDENCE_CONNECTOR_POLL_INTERVAL=10
EVIDENCE_SOURCE_SYSTEM=dokploy-file-connector
EVIDENCE_SCANNER_TYPE=external
EVIDENCE_ARTIFACT_TYPE=json

# Temporary vulnerable sandbox labs for live demos.
# The IaC lab is local and zero-cost. Real cloud/Kubernetes lab creation stays
# disabled until these flags are deliberately enabled for isolated test accounts.
SANDBOX_LABS_ENABLED=true
SANDBOX_LAB_INLINE_WORKER=false
SANDBOX_LAB_BASE_DIR=/app/sandbox-labs
SANDBOX_LAB_WORKER_ID=dokploy-sandbox-lab-worker-1
SANDBOX_LAB_WORKER_POLL_INTERVAL=10
SANDBOX_IAC_DEPLOY=true
SANDBOX_AWS_DEPLOY=false
SANDBOX_GCP_DEPLOY=false
SANDBOX_KUBERNETES_DEPLOY=false

# AI configuration. Leave blank for no external AI provider in the PoC.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=

# Optional email notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

LOG_LEVEL=INFO
