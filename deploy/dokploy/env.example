# CloudGuard Dokploy PoC environment
# Replace every "change-me" before deploying.

# Public domains. In Dokploy, add these as Domains for the backend service
# and route them to internal port 8000.
APP_DOMAIN=app.cloudscanner.example.com
API_DOMAIN=api.cloudscanner.example.com
INGEST_DOMAIN=ingest.cloudscanner.example.com
ALLOWED_HOSTS=app.cloudscanner.example.com,api.cloudscanner.example.com,ingest.cloudscanner.example.com
CORS_ORIGINS=https://app.cloudscanner.example.com,https://api.cloudscanner.example.com,https://ingest.cloudscanner.example.com

# Postgres
POSTGRES_DB=scanner_db
POSTGRES_USER=scanner_user
POSTGRES_PASSWORD=change-me-postgres-password

# Worker and connector auth
WORKER_TOKEN=change-me-worker-token
CONNECTOR_TOKEN=change-me-connector-token
CONNECTOR_USER_ID=anonymous

# Internal MinIO evidence storage for the PoC.
# For production, replace this with managed S3-compatible object storage if available.
MINIO_ROOT_USER=cloudguard-minio
MINIO_ROOT_PASSWORD=change-me-minio-root-password
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_REGION=dokploy
OBJECT_STORAGE_BUCKET=cloudguard-evidence
OBJECT_STORAGE_ACCESS_KEY_ID=cloudguard-minio
OBJECT_STORAGE_SECRET_ACCESS_KEY=change-me-minio-root-password
OBJECT_STORAGE_PREFIX=cloudguard/evidence

# App secrets
SECRET_KEY=change-me-secret-key
ENCRYPTION_KEY=change-me-encryption-key

# Scanner runtime
SCAN_WORKER_ID=dokploy-scan-worker-1
SCAN_WORKER_POLL_INTERVAL=10
SCAN_JOB_TIMEOUT_MINUTES=20
EVIDENCE_CONNECTOR_POLL_INTERVAL=10
EVIDENCE_SOURCE_SYSTEM=dokploy-file-connector
EVIDENCE_SCANNER_TYPE=external
EVIDENCE_ARTIFACT_TYPE=json

# AI configuration. Leave blank for no external AI provider in the PoC.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=

# Optional email notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

LOG_LEVEL=INFO
