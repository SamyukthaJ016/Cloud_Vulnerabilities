# Public routes managed by Dokploy.
APP_DOMAIN=grc.sc.deeptrustxai.com
KEYCLOAK_HOSTNAME=auth.sc.deeptrustxai.com
KEYCLOAK_PUBLIC_URL=https://auth.sc.deeptrustxai.com/auth
KEYCLOAK_REALM=gigachad-grc
KEYCLOAK_ISSUER=https://auth.sc.deeptrustxai.com/auth/realms/gigachad-grc

# GRC database and cache. Replace every change-me value before deployment.
POSTGRES_USER=grc_app
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=gigachad_grc
KEYCLOAK_DB=keycloak
REDIS_PASSWORD=change-me-redis-password

# Keycloak bootstrap administrator. Remove these variables after the first
# successful bootstrap if the deployment no longer needs to recreate the realm.
KEYCLOAK_ADMIN=grc-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password

# Internal S3-compatible evidence storage.
MINIO_ROOT_USER=grc-storage
MINIO_ROOT_PASSWORD=change-me-object-storage-password

# Application signing and connector secrets.
JWT_SECRET=change-me-jwt-secret-at-least-64-characters
CLOUDGUARD_API_URL=https://cloudguard.sc.deeptrustxai.com
CLOUDGUARD_CONNECTOR_CREDENTIALS_JSON={"demo-tenant":{"connector_id":"grc-demo-tenant","token":"change-me-grc-connector-token-at-least-32-characters","tenant_id":"demo-tenant","user_id":"grc-service-user","scopes":["grc:read"]}}

LOG_LEVEL=info
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
